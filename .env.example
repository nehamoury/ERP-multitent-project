# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/attendance_crm"

# NextAuth (session encryption)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-64-char-hex-string"

# JWT for custom APIs + socket tokens (separate from NEXTAUTH_SECRET)
JWT_SECRET="change-this-to-a-64-char-hex-string"

# Razorpay Payment Gateway
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="rzp_test_xxxxxxxxxxxxxxxxxxxx"

# Socket Gateway Configuration
NEXT_PUBLIC_SOCKET_URL="http://localhost:3002"
INTERNAL_SOCKET_URL="http://localhost:3002"
SOCKET_SECRET="change-this-to-a-64-char-hex-string"

# Internal API secret for socket-server → ERP validation calls
INTERNAL_API_SECRET="change-this-to-a-64-char-hex-string"

# Cron Job Authentication
CRON_SECRET="change-this-to-a-64-char-hex-string"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="AttendIQ <no-reply@attendiq.com>"

# App
NEXT_PUBLIC_APP_NAME="AttendIQ"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature Flags (set false in production)
ENABLE_DEMO_LOGIN=true
