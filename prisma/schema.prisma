// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  HR
  EMPLOYEE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  WORK_FROM_HOME
  ON_LEAVE
}

enum LeaveType {
  ANNUAL
  SICK
  CASUAL
  MATERNITY
  PATERNITY
  EMERGENCY
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  CHECKIN
  CHECKOUT
  APPROVE
  REJECT
  EXPORT
}

enum VendorStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum PlanName {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  EXPIRED
  CANCELLED
  PAST_DUE
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PromotionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Vendor {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  email          String       @unique @default("temp@attendiq.com")
  phone          String?
  logo           String?
  billingAddress String?
  state          String?
  gstin          String?
  code           String?
  website        String?
  status         VendorStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  users               User[]
  attendance          Attendance[]
  leaves              Leave[]
  activityLogs        ActivityLog[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  notices             Notice[]
  projects            Project[]
  tasks               Task[]
  companySettings     CompanySettings?
  subscription        VendorSubscription?
  subscriptionHistory SubscriptionHistory[]
  paymentTransactions PaymentTransaction[]
  usageLogs           UsageLog[]
  invoices            BillingInvoice[]
  clientInvoices      ClientInvoice[]
  payrolls            Payroll[]
  workReports         WorkReport[]
  permissions         Permission[]
  branches            Branch[]
  departments         Department[]
  teams               Team[]
  designations        Designation[]
  employeeTransfers   EmployeeTransfer[]
  promotionHistory    PromotionHistory[]
  employeeHistory     EmployeeHistory[]
  documents           Document[]
  supportTickets      SupportTicket[]
  chatRooms           ChatRoom[]
  chatParticipants    ChatParticipant[]
  messages            Message[]
  messageReads        MessageRead[]

  @@map("vendors")
}

model User {
  id                 String    @id @default(cuid())
  vendorId           String
  employeeId         String
  name               String
  email              String    @unique
  password           String
  role               Role      @default(EMPLOYEE)
  departmentId       String?
  designationId      String?
  teamId             String?
  branchId           String?
  reportingManagerId String?
  phone              String?
  profileImage       String?
  // New profile fields
  fathersName        String?
  address            String?
  linkedInUrl        String?
  dateOfBirth        DateTime?
  gender             String?
  // End new fields
  isActive           Boolean   @default(true)
  joinDate           DateTime  @default(now())
  shiftStart         String    @default("09:00")
  shiftEnd           String    @default("18:00")
  qrToken            String?   @unique // For QR-based check-in
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  vendor            Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  attendance        Attendance[]
  leavesRequested   Leave[]        @relation("LeaveRequester")
  leavesApproved    Leave[]        @relation("LeaveApprover")
  activityLogs      ActivityLog[]  @relation("ActivityActor")
  auditLogs         AuditLog[]     @relation("AuditActor")
  sessions          Session[]
  notifications     Notification[]
  notices           Notice[]
  managedProjects   Project[]      @relation("ProjectManager")
  memberProjects    Project[]      @relation("ProjectMembers")
  assignedTasks     Task[]
  taskUpdates       TaskUpdate[]
  payrolls          Payroll[]
  workReports       WorkReport[]
  reviewedReports   WorkReport[]   @relation("ReportReviewer")
  department        Department?    @relation(fields: [departmentId], references: [id])
  designation       Designation?   @relation(fields: [designationId], references: [id])
  team              Team?          @relation(fields: [teamId], references: [id])
  branch            Branch?        @relation(fields: [branchId], references: [id])
  reportingManager  User?          @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  subordinates      User[]         @relation("ReportingManager")
  managedBranches   Branch[]       @relation("BranchManager")
  headedDepartments Department[]   @relation("DepartmentHead")
  leadTeams         Team[]         @relation("TeamLead")

  transfers          EmployeeTransfer[] @relation("EmployeeTransfers")
  requestedTransfers EmployeeTransfer[] @relation("RequestedTransfers")
  approvedTransfers  EmployeeTransfer[] @relation("ApprovedTransfers")

  promotions          PromotionHistory[] @relation("EmployeePromotions")
  requestedPromotions PromotionHistory[] @relation("RequestedPromotions")
  approvedPromotions  PromotionHistory[] @relation("ApprovedPromotions")

  historyRecords EmployeeHistory[] @relation("EmployeeHistoryRecords")
  uploadedDocuments Document[]     @relation("DocumentUploader")
  createdTickets    SupportTicket[] @relation("TicketCreator")
  assignedTickets   SupportTicket[] @relation("TicketAssignee")
  chatParticipants  ChatParticipant[]
  sentMessages      Message[]
  messageReads      MessageRead[]

  @@unique([vendorId, employeeId])
  @@unique([id, vendorId])
  @@index([vendorId])
  @@index([role])
  @@index([departmentId])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Attendance {
  id           String           @id @default(cuid())
  vendorId     String
  userId       String
  date         DateTime
  checkIn      DateTime?
  checkOut     DateTime?
  workingHours Float?
  status       AttendanceStatus @default(ABSENT)
  isLate       Boolean          @default(false)
  lateMinutes  Int?
  note         String?
  ipAddress    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relations
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@unique([id, vendorId])
  @@index([vendorId])
  @@index([date])
  @@index([userId])
  @@map("attendance")
}

model Leave {
  id            String      @id @default(cuid())
  vendorId      String
  userId        String
  approverId    String?
  type          LeaveType
  status        LeaveStatus @default(PENDING)
  startDate     DateTime
  endDate       DateTime
  totalDays     Int
  reason        String
  rejectionNote String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user     User   @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  approver User?  @relation("LeaveApprover", fields: [approverId], references: [id])

  @@unique([id, vendorId])
  @@index([vendorId])
  @@index([userId])
  @@index([status])
  @@map("leaves")
}

model ActivityLog {
  id          String   @id @default(cuid())
  vendorId    String
  userId      String
  action      String
  description String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  // Relations
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user   User   @relation("ActivityActor", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, vendorId])
  @@index([vendorId])
  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model AuditLog {
  id          String      @id @default(cuid())
  vendorId    String
  actorId     String
  action      AuditAction
  entityType  String
  entityId    String
  oldValues   Json?
  newValues   Json?
  description String
  ipAddress   String?
  createdAt   DateTime    @default(now())

  // Relations
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  actor  User   @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([id, vendorId])
  @@index([vendorId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(cuid())
  vendorId  String
  userId    String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, vendorId])
  @@index([vendorId])
  @@index([userId])
  @@map("notifications")
}

model CompanySettings {
  id                String   @id @default(cuid())
  vendorId          String   @unique
  companyName         String   @default("Acme Corp")
  workingHoursStart   String   @default("09:00")
  workingHoursEnd     String   @default("18:00")
  breakStart          String?
  breakEnd            String?
  gracePeriod         Int      @default(15)
  lateThreshold       Int      @default(15)
  halfDayThreshold    Int      @default(240)
  absentThreshold     Int      @default(480)
  minimumWorkingHours Int      @default(8)
  overtimeEnabled     Boolean  @default(false)
  timezone            String   @default("Asia/Kolkata")
  workingDays         Json     @default("[1,2,3,4,5]")
  halfDaySupport      Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  // Relations
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

// ─── Organization Structure (Sprint 1) ───────────────────────────────────────

model Branch {
  id            String   @id @default(cuid())
  vendorId      String
  name          String
  code          String?
  location      String?
  address       String?
  city          String?
  state         String?
  country       String?
  contactPerson String?
  contactNumber String?
  isActive      Boolean  @default(true)
  managerId     String?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vendor  Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  manager User?  @relation("BranchManager", fields: [managerId], references: [id])
  users   User[]
  departments Department[]
  teams       Team[]

  @@unique([name, vendorId])
  @@index([vendorId])
  @@map("branches")
}

model Department {
  id          String   @id @default(cuid())
  vendorId    String
  name        String
  code        String?
  description String?  @db.Text
  isActive    Boolean  @default(true)
  headId      String?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor       Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?       @relation(fields: [branchId], references: [id])
  parentDepartmentId String?
  parentDepartment   Department?  @relation("ParentChildDepartment", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments   Department[] @relation("ParentChildDepartment")
  head         User?         @relation("DepartmentHead", fields: [headId], references: [id])
  teams        Team[]
  designations Designation[]
  users        User[]
  projects     Project[]

  @@unique([name, vendorId])
  @@index([vendorId])
  @@index([branchId])
  @@index([parentDepartmentId])
  @@map("departments")
}

model Team {
  id           String   @id @default(cuid())
  vendorId     String
  departmentId String
  name         String
  code         String?
  description  String?  @db.Text
  isActive     Boolean  @default(true)
  maxMembers   Int?
  leadId       String?
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor     Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?    @relation(fields: [branchId], references: [id])
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  lead       User?      @relation("TeamLead", fields: [leadId], references: [id])
  users      User[]
  projects   Project[]

  @@unique([name, departmentId])
  @@unique([code, vendorId])
  @@index([vendorId])
  @@index([branchId])
  @@index([departmentId])
  @@map("teams")
}

model Designation {
  id           String   @id @default(cuid())
  vendorId     String
  departmentId String
  name         String
  level        String?
  description  String?  @db.Text
  isActive     Boolean  @default(true)
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor     Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users      User[]

  @@unique([name, departmentId])
  @@index([vendorId])
  @@index([departmentId])
  @@map("designations")
}

model EmployeeTransfer {
  id         String @id @default(cuid())
  vendorId   String
  employeeId String

  oldBranchId     String?
  newBranchId     String?
  oldDepartmentId String?
  newDepartmentId String?
  oldTeamId       String?
  newTeamId       String?

  effectiveDate DateTime
  reason        String?
  status        TransferStatus @default(PENDING)

  requestedById String
  approvedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor      Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  employee    User   @relation("EmployeeTransfers", fields: [employeeId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("RequestedTransfers", fields: [requestedById], references: [id])
  approvedBy  User?  @relation("ApprovedTransfers", fields: [approvedById], references: [id])

  @@index([vendorId])
  @@index([employeeId])
  @@index([status])
  @@map("employee_transfers")
}

model PromotionHistory {
  id         String @id @default(cuid())
  vendorId   String
  employeeId String

  oldDesignationId String
  newDesignationId String

  oldLevel String?
  newLevel String?

  oldSalary Float?
  newSalary Float?

  effectiveDate DateTime
  reason        String?
  status        PromotionStatus @default(PENDING)

  requestedById String
  approvedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor      Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  employee    User   @relation("EmployeePromotions", fields: [employeeId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("RequestedPromotions", fields: [requestedById], references: [id])
  approvedBy  User?  @relation("ApprovedPromotions", fields: [approvedById], references: [id])

  @@index([vendorId])
  @@index([employeeId])
  @@index([status])
  @@map("promotion_history")
}

model EmployeeHistory {
  id         String @id @default(cuid())
  vendorId   String
  employeeId String

  action  String
  details Json

  createdAt DateTime @default(now())

  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  employee User   @relation("EmployeeHistoryRecords", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([employeeId])
  @@index([createdAt])
  @@map("employee_history")
}

// ─── Notice Board ─────────────────────────────────────────────────────────────

enum NoticeType {
  INFO
  WARNING
  URGENT
  SUCCESS
}

model Notice {
  id        String     @id @default(cuid())
  vendorId  String
  title     String
  content   String     @db.Text
  type      NoticeType @default(INFO)
  authorId  String
  isActive  Boolean    @default(true)
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@unique([id, vendorId])
  @@index([vendorId])
  @@index([authorId])
  @@map("notices")
}

// ─── Project & Tasks ─────────────────────────────────────────────────────────

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id          String        @id @default(cuid())
  vendorId    String
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  managerId   String
  departmentId String?
  teamId       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  vendor     Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  manager    User        @relation("ProjectManager", fields: [managerId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  team       Team?       @relation(fields: [teamId], references: [id])
  members    User[]      @relation("ProjectMembers")
  tasks      Task[]

  @@unique([id, vendorId])
  @@index([vendorId])
  @@index([managerId])
  @@index([departmentId])
  @@index([teamId])
  @@map("projects")
}

model Task {
  id          String       @id @default(cuid())
  vendorId    String
  projectId   String
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  dueDate     DateTime?
  progress    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  updates     TaskUpdate[]

  vendor   Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation(fields: [assigneeId], references: [id])

  @@unique([id, vendorId])
  @@index([vendorId])
  @@index([projectId])
  @@index([assigneeId])
  @@map("tasks")
}

model TaskUpdate {
  id          String      @id @default(cuid())
  taskId      String
  userId      String
  content     String?     @db.Text
  progress    Int?
  status      TaskStatus?
  createdAt   DateTime    @default(now())

  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])
  
  @@map("task_updates")
}

// ─── Client Invoice ──────────────────────────────────────────────────────────

enum ClientInvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model ClientInvoice {
  id            String              @id @default(cuid())
  vendorId      String
  clientName    String
  clientEmail   String?
  clientPhone   String?
  invoiceNumber String              @unique
  amount        Float
  gstAmount     Float               @default(0)
  totalAmount   Float
  status        ClientInvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String?             @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([id, vendorId])
  @@index([vendorId])
  @@map("client_invoices")
}

// ─── Payroll ────────────────────────────────────────────────────────────────

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
  CANCELLED
}

model Payroll {
  id          String        @id @default(cuid())
  vendorId    String
  userId      String
  month       Int
  year        Int
  basicSalary Float
  allowances  Float         @default(0)
  deductions  Float         @default(0)
  netAmount   Float
  status      PayrollStatus @default(DRAFT)
  paidAt      DateTime?
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([vendorId, userId, month, year])
  @@unique([id, vendorId])
  @@index([vendorId])
  @@index([userId])
  @@map("payrolls")
}

// ─── Work Reports ──────────────────────────────────────────────────────────

enum WorkReportStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model WorkReport {
  id          String           @id @default(cuid())
  vendorId    String
  userId      String
  date        DateTime
  description String           @db.Text
  hoursWorked Float
  status      WorkReportStatus @default(SUBMITTED)
  reviewedBy  String?
  reviewNote  String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id])
  reviewer User?  @relation("ReportReviewer", fields: [reviewedBy], references: [id])

  @@unique([id, vendorId])
  @@unique([vendorId, userId, date])
  @@index([vendorId])
  @@index([userId])
  @@map("work_reports")
}

// ─── Role Permissions ──────────────────────────────────────────────────────

model Permission {
  id        String   @id @default(cuid())
  vendorId  String
  role      Role
  resource  String
  canCreate Boolean  @default(false)
  canRead   Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, role, resource])
  @@index([vendorId])
  @@map("permissions")
}

// ─── Subscription & Billing ───────────────────────────────────────────────────

model SubscriptionPlan {
  id           String   @id @default(cuid())
  name         PlanName @unique
  priceMonthly Float
  priceYearly  Float
  maxEmployees Int
  features     Json // Array of enabled feature keys
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions VendorSubscription[]

  @@map("subscription_plans")
}

model VendorSubscription {
  id                 String             @id @default(cuid())
  vendorId           String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  vendor Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("vendor_subscriptions")
}

model SubscriptionHistory {
  id            String   @id @default(cuid())
  vendorId      String
  oldPlan       String?
  newPlan       String
  amount        Float
  paymentStatus String
  createdAt     DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("subscription_history")
}

model PaymentTransaction {
  id            String   @id @default(cuid())
  vendorId      String
  amount        Float
  gateway       String
  transactionId String?
  status        String
  createdAt     DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("payment_transactions")
}

model UsageLog {
  id        String   @id @default(cuid())
  vendorId  String
  action    String
  createdAt DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("usage_logs")
}

model BillingInvoice {
  id            String   @id @default(cuid())
  vendorId      String
  invoiceNumber String   @unique
  planName      String
  amount        Float
  gstAmount     Float
  totalAmount   Float
  status        String   @default("PENDING") // PENDING, PAID, FAILED
  paymentId     String?
  invoiceDate   DateTime @default(now())
  pdfUrl        String?

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("billing_invoices")
}

// ─── Documents ────────────────────────────────────────────────────────────────
model Document {
  id          String   @id @default(cuid())
  vendorId    String
  uploaderId  String
  title       String
  description String?  @db.Text
  fileUrl     String
  fileType    String
  size        Int      @default(0)
  folder      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  uploader User   @relation("DocumentUploader", fields: [uploaderId], references: [id])

  @@unique([id, vendorId])
  @@index([vendorId])
  @@index([uploaderId])
  @@map("documents")
}

// ─── Support Tickets ──────────────────────────────────────────────────────────
model SupportTicket {
  id           String         @id @default(cuid())
  vendorId     String
  creatorId    String
  subject      String
  description  String         @db.Text
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  assignedToId String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  vendor     Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  creator    User   @relation("TicketCreator", fields: [creatorId], references: [id])
  assignedTo User?  @relation("TicketAssignee", fields: [assignedToId], references: [id])

  @@unique([id, vendorId])
  @@index([vendorId])
  @@index([creatorId])
  @@index([assignedToId])
  @@map("support_tickets")
}

// ─── Chat System ──────────────────────────────────────────────────────────────

enum ChatRoomType {
  DIRECT
  GROUP
  PROJECT
  DEPARTMENT
  TEAM
  BROADCAST
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  PDF
  DOC
  AUDIO
  VIDEO
}

model ChatRoom {
  id            String   @id @default(cuid())
  vendorId      String

  name          String?
  type          ChatRoomType

  projectId     String?
  departmentId  String?
  teamId        String?

  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participants  ChatParticipant[]
  messages      Message[]

  vendor        Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  
  @@index([vendorId])
  @@map("chat_rooms")
}

model ChatParticipant {
  id          String @id @default(cuid())
  vendorId    String

  roomId      String
  userId      String

  joinedAt    DateTime @default(now())
  isAdmin     Boolean @default(false)

  room        ChatRoom @relation(fields:[roomId], references:[id], onDelete: Cascade)
  user        User @relation(fields:[userId], references:[id], onDelete: Cascade)
  vendor      Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId, vendorId])
  @@index([vendorId])
  @@index([roomId])
  @@index([userId])
  @@map("chat_participants")
}

model Message {
  id            String @id @default(cuid())
  vendorId      String

  roomId        String
  senderId      String

  messageType   MessageType
  content       String?     @db.Text
  fileUrl       String?
  fileName      String?
  fileSize      Int?

  isEdited      Boolean  @default(false)
  isDeleted     Boolean  @default(false)
  replyToId     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  room          ChatRoom @relation(fields:[roomId], references:[id], onDelete: Cascade)
  sender        User @relation(fields:[senderId], references:[id], onDelete: Cascade)
  vendor        Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  
  replyTo       Message?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies       Message[] @relation("MessageReplies")
  reads         MessageRead[]

  @@index([vendorId])
  @@index([roomId])
  @@map("messages")
}

model MessageRead {
  id          String @id @default(cuid())
  vendorId    String

  messageId   String
  userId      String

  readAt      DateTime @default(now())

  message     Message @relation(fields:[messageId], references:[id], onDelete: Cascade)
  user        User @relation(fields:[userId], references:[id], onDelete: Cascade)
  vendor      Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, vendorId])
  @@index([vendorId])
  @@map("message_reads")
}
